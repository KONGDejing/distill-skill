ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Optional: only for gateways using bearer authentication or an outbound proxy.
ANTHROPIC_AUTH_TOKEN=
HTTPS_PROXY=
CLAUDE_MODEL=claude-sonnet-4-6
FACTORY_FALLBACK_MODEL=claude-sonnet-4-5-20250929
# Pause new production steps on high memory; resume explicitly in the dashboard.
FACTORY_MAX_MEMORY_GIB=16
FACTORY_MIN_AVAILABLE_GIB=2
FACTORY_MIN_AVAILABLE_PERCENT=8
FACTORY_MAX_MEMORY_STALL_PERCENT=5
COSYVOICE_DIR=backend/engines/CosyVoice
COSYVOICE_MODEL_DIR=backend/storage/models/CosyVoice2-0.5B
VOICE_CLONE_COMMAND=python backend/services/clone_tts.py --ref {sample_path} --text {text_file} --out {output_path}

# Factory employees: anthropic, openai (Responses API), or codex (saved ChatGPT login).
# Chat/Codex subscriptions are not API credentials. Never commit a real key.
FACTORY_MODEL_PROVIDER=anthropic
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
FACTORY_OPENAI_MODEL=gpt-6-astra
FACTORY_OPENAI_FALLBACK_MODEL=
FACTORY_OPENAI_REASONING=low
FACTORY_CODEX_MODEL=gpt-6-astra
FACTORY_CODEX_BIN=codex
FACTORY_CODEX_TIMEOUT_SECONDS=180
# Optional per-run token stop. 0 disables it; provider usage limits still apply.
FACTORY_MAX_TOTAL_TOKENS=0
