  "tracks": [
    {
      "editor": "小影2",
      "direction": "论文讲解",
      "subjects": "最新AI大模型论文、机器人及具身智能论文",
      "story": "研究问题 → 方法 → 实验结果 → 条件与局限",
      "visual": "保留已认可的论文PPT讲解：真实PDF、原文高亮、方法图、实验图表；有对应作者成果演示可穿插，不强制改成混剪。",
      "voice": "沉稳男声，准确清楚，像研究者带读论文",
      "example": "这篇新论文解决什么问题，方法与实验依据在哪里？",
      "daily_quota": 0,
      "weekly_quota": 2,
      "publishing": "manual_only_no_douyin"
    },
    {
      "editor": "小影",
      "direction": "前沿科技成果与AI真实落地场景科普",
      "subjects": "机械手与机器人、AI软件和智能体成果、AI智能硬件与陪伴玩具、端侧AI、自动驾驶与智慧避障、无人机与低空经济、无人船、炒菜机器人、航天器与太空飞行，以及公开的军事科技应用进展",
      "story": "先展示真实成果或实验场景 → 解释研究突破与原理 → 说明进展、条件及未来应用",
      "visual": "有科技大片的视觉感，以真实实验、动作、产品和现场素材为主体；必要动画与AI合成用于解释机制、展示标识清楚的示意场景。先写完整口播再逐句匹配镜头。 按已核对的新智元视频学习真实主体、中上部标题、具体事件开场、短句口播驱动画面与证据呈现；不复制其标识或原稿。",
      "voice": "有惊奇感、有信息量的科普叙事；不写成软件操作教程或购买评测",
      "example": "这项研究让机械手、自动驾驶或飞行器推进到了哪一步？真实场景里发生了什么，AI如何做到？",
      "daily_quota": 4
    },
    {
      "editor": "小影3",
      "direction": "AI圈人物及海外科技公司大新闻",
      "subjects": "重点海外人物和公司：公开言论、决策、组织变动、重大合作、争议；AI投入、芯片/存储、重要航天与科技事件；国内仅指定七家",
      "story": "发生了什么 → 谁说了什么或做了什么 → 为什么引起关注 → 影响与待确认部分",
      "visual": "原始发言/采访片段、事件相关动态素材、发布会、简短原话和时间线、必要动态图解；形成新闻故事，整片不采用论文PPT模板。",
      "voice": "有新闻叙事感，有钩子和转折，事实、说法归属与自己的分析清楚分开",
      "example": "辛顿的新判断为什么引起争论？某家公司作出了什么重大AI决策？",
      "daily_quota": 2
    }
